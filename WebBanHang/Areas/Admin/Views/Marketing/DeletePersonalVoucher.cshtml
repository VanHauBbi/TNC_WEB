@model WebBanHang.Models.ViewModel.PersonalVoucherAdminVM
@{
    ViewBag.Title = "Ngừng voucher cá nhân";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}
<div class="container-fluid py-3"><div class="card shadow-sm border-danger mx-auto" style="max-width:760px"><div class="card-header bg-danger text-white"><h4 class="mb-0"><i class="fa-solid fa-ban"></i> Ngừng áp dụng voucher</h4></div><div class="card-body p-4">
    <div class="alert alert-warning">Thao tác này <strong>không xóa dữ liệu</strong>. Voucher sẽ không thể sử dụng tiếp, nhưng lịch sử khách hàng và đơn hàng vẫn được giữ.</div>
    <dl class="row"><dt class="col-sm-4">Mã</dt><dd class="col-sm-8"><code>@Model.Code</code></dd><dt class="col-sm-4">Khách hàng</dt><dd class="col-sm-8">@Model.CustomerName</dd><dt class="col-sm-4">Sản phẩm</dt><dd class="col-sm-8">@Model.ProductName</dd><dt class="col-sm-4">Tiền giảm</dt><dd class="col-sm-8 fw-bold text-danger">@Model.DiscountAmount.ToString("N0") ₫</dd></dl>
    @using (Html.BeginForm()) { @Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.CustomerCouponID" /><button class="btn btn-danger" type="submit"><i class="fa-solid fa-ban"></i> Xác nhận ngừng áp dụng</button><a class="btn btn-secondary ms-2" href="@Url.Action("PersonalVoucherDetails", new { id = Model.CustomerCouponID })">Hủy</a> }
</div></div></div>
