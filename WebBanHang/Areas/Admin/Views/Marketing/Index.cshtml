@model WebBanHang.Models.ViewModel.MarketingDashboardVM
@using System.Globalization
@using System.Collections.Generic
@{
    ViewBag.Title = "Marketing Selling";
    ViewBag.RemoveSpacing = true;
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<link href="~/Content/Admin/marketing_admin.css" rel="stylesheet" />

@if (TempData["SuccessMessage"] != null)
{
    <div class="mk-toast"><div class="d-flex align-items-center gap-3"><i class="fa-solid fa-circle-check text-success fs-5"></i><div><strong>Thành công</strong><div class="small text-muted">@TempData["SuccessMessage"]</div></div></div></div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="mk-toast danger"><div class="d-flex align-items-center gap-3"><i class="fa-solid fa-triangle-exclamation text-danger fs-5"></i><div><strong>Có lỗi xảy ra</strong><div class="small text-muted">@TempData["ErrorMessage"]</div></div></div></div>
}

<div class="mk-page">
    <div class="mk-hero">
        <div class="d-flex align-items-center gap-3">
            <div class="mk-hero-icon"><i class="fa-solid fa-bullseye"></i></div>
            <div><h2>Trung tâm Marketing Selling</h2><p>Quản lý voucher theo hành vi và combo mua chung từ dữ liệu Hybrid.</p></div>
        </div>
        <a href="@Url.Action("Index", "SmartRecommendation", new { area = "Admin" })" class="mk-btn mk-btn-warning"><i class="fa-solid fa-wand-magic-sparkles"></i> Xem dữ liệu Hybrid</a>
    </div>

    @if (ViewBag.SchemaError != null)
    {
        <div class="alert alert-danger border-0 shadow-sm">@ViewBag.SchemaError</div>
    }

    <div class="mk-stat-grid">
        <div class="mk-stat"><div class="mk-stat-icon blue"><i class="fa-solid fa-user-tag"></i></div><div><div class="mk-stat-label">Voucher hoạt động</div><div class="mk-stat-value">@Model.ActivePersonalVouchers</div></div></div>
        <div class="mk-stat"><div class="mk-stat-icon green"><i class="fa-solid fa-boxes-stacked"></i></div><div><div class="mk-stat-label">Combo hoạt động</div><div class="mk-stat-value">@Model.ActiveComboOffers</div></div></div>
        <div class="mk-stat"><div class="mk-stat-icon amber"><i class="fa-solid fa-ticket"></i></div><div><div class="mk-stat-label">Voucher đã dùng</div><div class="mk-stat-value">@Model.RedeemedVouchers</div></div></div>
        <div class="mk-stat"><div class="mk-stat-icon violet"><i class="fa-solid fa-chart-line"></i></div><div><div class="mk-stat-label">Doanh thu có ưu đãi</div><div class="mk-stat-value">@Model.RevenueInfluenced.ToString("N0") ₫</div></div></div>
    </div>

    <div class="mk-card">
        <div class="mk-card-header">
            <div class="mk-card-title"><div class="mk-card-title-icon"><i class="fa-solid fa-sliders"></i></div><div><h5>Cấu hình chiến dịch</h5><small>Thiết lập ngưỡng phát voucher và tạo combo tự động.</small></div></div>
        </div>
        <div class="mk-card-body">
            @using (Html.BeginForm("SaveSettings", "Marketing", FormMethod.Post, new { area = "Admin" }))
            {
                @Html.AntiForgeryToken()
                if (!ViewData.ModelState.IsValid) { @Html.ValidationSummary(false, "Vui lòng kiểm tra các giá trị sau:", new { @class = "alert alert-danger" }) }
                <div class="mk-config-note"><strong><i class="fa-solid fa-shield-halved me-1"></i> Bảo vệ tự động:</strong> Admin chỉ chọn chế độ kinh doanh. Hệ thống tự tính FIFO và tự hạ tiền giảm nếu cần; mỗi đơn chỉ nhận một combo tốt nhất.</div>
                <div class="row g-3">
                    <div class="col-xl-6">
                        <div class="mk-config-panel personal">
                            <div class="mk-config-heading"><i class="fa-solid fa-user-tag"></i> Voucher cá nhân</div>
                            <div class="mk-config-subtitle">Một ưu đãi cho sản phẩm khách quan tâm nhất.</div>
                            <div class="row g-3">
                                <div class="col-md-6"><label class="form-label">Tỷ lệ giảm</label><div class="input-group">@Html.TextBox("PersonalDiscountPct", Model.Settings.PersonalDiscountPct.ToString("0.##", CultureInfo.InvariantCulture), new { @class = "form-control", type = "number", step = "0.01", min = "0.01", max = "100" })<span class="input-group-text">%</span></div></div>
                                <div class="col-md-6"><label class="form-label">Tiền giảm tối đa</label><div class="input-group">@Html.TextBox("PersonalMaxDiscountAmount", Model.Settings.PersonalMaxDiscountAmount.ToString("0.##", CultureInfo.InvariantCulture), new { @class = "form-control", type = "number", min = "1000", step = "1000" })<span class="input-group-text">₫</span></div></div>
                                <div class="col-md-6"><label class="form-label">Điểm quan tâm tối thiểu</label>@Html.TextBox("PersonalMinInterestScore", Model.Settings.PersonalMinInterestScore.ToString("0.##", CultureInfo.InvariantCulture), new { @class = "form-control", type = "number", step = "0.1", min = "0" })<div class="form-text">Điểm từ xem, click và thêm giỏ.</div></div>
                                <div class="col-md-6"><label class="form-label">Hiệu lực voucher</label><div class="input-group">@Html.TextBox("VoucherValidityHours", Model.Settings.VoucherValidityHours, new { @class = "form-control", type = "number", min = "1" })<span class="input-group-text">giờ</span></div></div>
                                <div class="col-md-6"><label class="form-label">Chờ trước khi phát lại</label><div class="input-group">@Html.TextBox("VoucherCooldownDays", Model.Settings.VoucherCooldownDays, new { @class = "form-control", type = "number", min = "0" })<span class="input-group-text">ngày</span></div></div>
                                <div class="col-md-6"><label class="form-label">Bảo vệ lợi nhuận</label>@Html.DropDownList("PersonalMinimumMarginPct", new List<SelectListItem> { new SelectListItem { Text = "An toàn – 10%", Value = "10", Selected = Model.Settings.PersonalMinimumMarginPct == 10m }, new SelectListItem { Text = "Cân bằng – 5%", Value = "5", Selected = Model.Settings.PersonalMinimumMarginPct != 10m && Model.Settings.PersonalMinimumMarginPct != 2m }, new SelectListItem { Text = "Đẩy bán – 2%", Value = "2", Selected = Model.Settings.PersonalMinimumMarginPct == 2m } }, new { @class = "form-select" })<div class="form-text">Hệ thống tự kiểm tra giá nhập FIFO.</div></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-6">
                        <div class="mk-config-panel combo">
                            <div class="mk-config-heading"><i class="fa-solid fa-boxes-stacked"></i> Combo mua chung</div>
                            <div class="mk-config-subtitle">Giảm đúng một lần trên tổng đơn khi đủ cặp sản phẩm.</div>
                            <div class="row g-3">
                                <div class="col-md-6"><label class="form-label">Tỷ lệ giảm trên giá cặp</label><div class="input-group">@Html.TextBox("ComboDiscountPct", Model.Settings.ComboDiscountPct.ToString("0.##", CultureInfo.InvariantCulture), new { @class = "form-control", type = "number", step = "0.01", min = "0.01", max = "100" })<span class="input-group-text">%</span></div></div>
                                <div class="col-md-6"><label class="form-label">Tiền giảm tối đa/cả combo</label><div class="input-group">@Html.TextBox("ComboMaxDiscountAmount", Model.Settings.ComboMaxDiscountAmount.ToString("0.##", CultureInfo.InvariantCulture), new { @class = "form-control", type = "number", min = "1000", step = "1000" })<span class="input-group-text">₫</span></div></div>
                                <div class="col-md-6"><label class="form-label">Số đơn mua chung tối thiểu</label>@Html.TextBox("ComboMinSupport", Model.Settings.ComboMinSupport, new { @class = "form-control", type = "number", min = "1" })</div>
                                <div class="col-md-6"><label class="form-label">Tỷ lệ mua kèm tối thiểu</label><div class="input-group">@Html.TextBox("ComboMinConfidencePercent", Model.Settings.ComboMinConfidencePercent.ToString("0.##", CultureInfo.InvariantCulture), new { @class = "form-control", type = "number", step = "0.01", min = "0", max = "100" })<span class="input-group-text">%</span></div></div>
                                <div class="col-md-6"><label class="form-label">Lợi nhuận TB của cặp</label><div class="input-group">@Html.TextBox("ComboMinUtility", Model.Settings.ComboMinUtility.ToString("0.##", CultureInfo.InvariantCulture), new { @class = "form-control", type = "number", step = "1000", min = "0" })<span class="input-group-text">₫</span></div></div>
                                <div class="col-md-6"><label class="form-label">Thời gian hoạt động</label><div class="input-group">@Html.TextBox("ComboValidityDays", Model.Settings.ComboValidityDays, new { @class = "form-control", type = "number", min = "1" })<span class="input-group-text">ngày</span></div></div>
                                <div class="col-md-6"><label class="form-label">Số đơn sử dụng tối đa</label><div class="input-group">@Html.TextBox("ComboUsageLimit", Model.Settings.ComboUsageLimit, new { @class = "form-control", type = "number", min = "1" })<span class="input-group-text">đơn</span></div></div>
                                <div class="col-md-6"><label class="form-label">Bảo vệ lợi nhuận</label>@Html.DropDownList("ComboMinimumMarginPct", new List<SelectListItem> { new SelectListItem { Text = "An toàn – 10%", Value = "10", Selected = Model.Settings.ComboMinimumMarginPct == 10m }, new SelectListItem { Text = "Cân bằng – 5%", Value = "5", Selected = Model.Settings.ComboMinimumMarginPct != 10m && Model.Settings.ComboMinimumMarginPct != 2m }, new SelectListItem { Text = "Đẩy bán – 2%", Value = "2", Selected = Model.Settings.ComboMinimumMarginPct == 2m } }, new { @class = "form-select" })</div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="mk-form-footer"><button class="mk-btn mk-btn-solid" type="submit"><i class="fa-solid fa-floppy-disk"></i> Lưu cấu hình</button></div>
            }
        </div>
    </div>

    <div class="mk-card">
        <div class="mk-card-header">
            <div class="mk-card-title"><div class="mk-card-title-icon"><i class="fa-solid fa-bolt"></i></div><div><h5>Chạy chiến dịch</h5><small>Lưu cấu hình trước khi tạo dữ liệu mới.</small></div></div>
            <div class="mk-toolbar">
                @using (Html.BeginForm("GeneratePersonalVouchers", "Marketing", FormMethod.Post, new { area = "Admin", @class = "m-0" })) { @Html.AntiForgeryToken()<button class="mk-btn mk-btn-primary" type="submit"><i class="fa-solid fa-user-tag"></i> Tạo voucher cá nhân</button> }
                @using (Html.BeginForm("GenerateComboOffers", "Marketing", FormMethod.Post, new { area = "Admin", @class = "m-0" })) { @Html.AntiForgeryToken()<button class="mk-btn mk-btn-success" type="submit"><i class="fa-solid fa-boxes-stacked"></i> Tạo combo mua chung</button> }
            </div>
        </div>
    </div>

    <div class="mk-card">
        <div class="mk-card-header"><div class="mk-card-title"><div class="mk-card-title-icon"><i class="fa-solid fa-user-tag"></i></div><div><h5>Voucher cá nhân gần đây</h5><small>Theo dõi ưu đãi được phát từ hành vi khách hàng.</small></div></div></div>
        <div class="mk-table-wrap">
            <table class="mk-table" style="min-width:900px">
                <colgroup><col style="width:14%" /><col style="width:28%" /><col style="width:15%" /><col style="width:13%" /><col style="width:16%" /><col style="width:14%" /></colgroup>
                <thead><tr><th>Mã voucher</th><th>Sản phẩm áp dụng</th><th>Mức quan tâm</th><th>Tiền giảm</th><th>Trạng thái</th><th class="text-end">Quản lý</th></tr></thead>
                <tbody>
                @if (Model.RecentPersonalVouchers.Any())
                {
                    foreach (var item in Model.RecentPersonalVouchers)
                    {
                        var isVoucherActive = item.Status != "USED" && item.Status != "EXPIRED" && item.ExpiresAt > DateTime.UtcNow;
                        var triggerLabel = item.TriggerType == "ADD_CART" ? "Đã thêm giỏ" : item.TriggerType == "CART_ABANDONED" ? "Bỏ quên giỏ" : item.TriggerType == "CLICK" ? "Đã click" : "Đã xem";
                        <tr>
                            <td><span class="mk-code" title="@item.Code">@item.Code</span></td>
                            <td><div class="mk-product"><img class="mk-product-img" src="@item.ProductImage" alt="" loading="lazy" /><div class="mk-product-name" title="@item.ProductName">@item.ProductName</div></div></td>
                            <td><div class="mk-metric">@item.InterestScore.ToString("0.##") điểm</div><div class="mk-metric-sub">@triggerLabel</div></td>
                            <td><span class="mk-money">@item.DiscountAmount.ToString("N0") ₫</span></td>
                            <td>@if (item.Status == "USED") { <span class="mk-badge info"><i class="fa-solid fa-check"></i> Đã dùng</span> } else if (isVoucherActive) { <span class="mk-badge success"><i class="fa-solid fa-circle"></i> Hoạt động</span> } else { <span class="mk-badge muted">Đã ngừng</span> }<div class="mk-metric-sub mt-1">HSD @item.ExpiresAt.ToLocalTime().ToString("dd/MM HH:mm")</div></td>
                            <td>@if (item.Status != "USED") { <div class="mk-action-group"><a class="mk-btn mk-btn-primary" title="Chi tiết" href="@Url.Action("PersonalVoucherDetails", new { id = item.CustomerCouponID })"><i class="fa-solid fa-eye"></i></a><a class="mk-btn mk-btn-warning" title="Chỉnh sửa" href="@Url.Action("EditPersonalVoucher", new { id = item.CustomerCouponID })"><i class="fa-solid fa-pen"></i></a><a class="mk-btn mk-btn-danger" title="Ngừng áp dụng" href="@Url.Action("DeletePersonalVoucher", new { id = item.CustomerCouponID })"><i class="fa-solid fa-ban"></i></a></div> }</td>
                        </tr>
                    }
                }
                else { <tr><td colspan="6" class="mk-empty"><i class="fa-solid fa-ticket"></i>Chưa có voucher cá nhân.</td></tr> }
                </tbody>
            </table>
        </div>
    </div>

    <div class="mk-card">
        <div class="mk-card-header"><div class="mk-card-title"><div class="mk-card-title-icon"><i class="fa-solid fa-boxes-stacked"></i></div><div><h5>Combo gần đây</h5><small>Bao gồm combo đang hoạt động và đã ngừng.</small></div></div></div>
        <div class="mk-table-wrap">
            <table class="mk-table" style="min-width:980px">
                <colgroup><col style="width:13%" /><col style="width:30%" /><col style="width:14%" /><col style="width:14%" /><col style="width:15%" /><col style="width:14%" /></colgroup>
                <thead><tr><th>Mã combo</th><th>Cặp sản phẩm</th><th>Dữ liệu mua chung</th><th>Lợi nhuận TB</th><th>Ưu đãi</th><th class="text-end">Quản lý</th></tr></thead>
                <tbody>
                @if (Model.ManagedCombos.Any())
                {
                    foreach (var item in Model.ManagedCombos)
                    {
                        var isComboActive = item.IsActive && item.EndDate > DateTime.Now && item.UsageLimit > 0;
                        <tr>
                            <td><span class="mk-code" title="@item.Code">@item.Code</span></td>
                            <td><div class="mk-pair"><div class="mk-product"><img class="mk-product-img" src="@item.ProductImageA" alt="" loading="lazy" /><div class="mk-product-name" title="@item.ProductNameA">@item.ProductNameA</div></div><div class="mk-product"><img class="mk-product-img" src="@item.ProductImageB" alt="" loading="lazy" /><div class="mk-product-name" title="@item.ProductNameB">@item.ProductNameB</div></div></div></td>
                            <td><div class="mk-metric">@item.Support đơn</div><div class="mk-metric-sub">Mua kèm @((item.Confidence * 100).ToString("0.##"))%</div></td>
                            <td><div class="mk-metric text-success">@item.ActualUtility.ToString("N0") ₫</div><div class="mk-metric-sub">trung bình/cặp</div></td>
                            <td><div class="mk-money">-@item.DiscountAmount.ToString("N0") ₫</div><div class="mt-1">@if (isComboActive) { <span class="mk-badge success">Đang hoạt động</span> } else { <span class="mk-badge muted">Đã ngừng</span> }</div></td>
                            <td><div class="mk-action-group"><a class="mk-btn mk-btn-primary" title="Chi tiết" href="@Url.Action("ComboDetails", new { id = item.ComboOfferID })"><i class="fa-solid fa-eye"></i></a><a class="mk-btn mk-btn-warning" title="Chỉnh sửa" href="@Url.Action("EditCombo", new { id = item.ComboOfferID })"><i class="fa-solid fa-pen"></i></a><a class="mk-btn mk-btn-danger" title="Ngừng áp dụng" href="@Url.Action("DeleteCombo", new { id = item.ComboOfferID })"><i class="fa-solid fa-ban"></i></a></div></td>
                        </tr>
                    }
                }
                else { <tr><td colspan="6" class="mk-empty"><i class="fa-solid fa-box-open"></i>Chưa có combo để quản lý.</td></tr> }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>$(function () { if ($('.mk-toast').length) setTimeout(function () { $('.mk-toast').fadeOut(350); }, 5000); });</script>
}
