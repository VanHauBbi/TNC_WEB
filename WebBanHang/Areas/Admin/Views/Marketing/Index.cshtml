@model WebBanHang.Models.ViewModel.MarketingDashboardVM
@using System.Globalization
@using System.Collections.Generic
@{
    ViewBag.Title = "Marketing Selling";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-3">
    @if (ViewBag.SchemaError != null)
    {
        <div class="alert alert-danger">@ViewBag.SchemaError</div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-3"><div class="card shadow-sm border-0 p-3"><small>Voucher đang hoạt động</small><h3>@Model.ActivePersonalVouchers</h3></div></div>
        <div class="col-md-3"><div class="card shadow-sm border-0 p-3"><small>Combo đang hoạt động</small><h3>@Model.ActiveComboOffers</h3></div></div>
        <div class="col-md-3"><div class="card shadow-sm border-0 p-3"><small>Voucher đã sử dụng</small><h3>@Model.RedeemedVouchers</h3></div></div>
        <div class="col-md-3"><div class="card shadow-sm border-0 p-3"><small>Doanh thu có ưu đãi</small><h3>@Model.RevenueInfluenced.ToString("N0") ₫</h3></div></div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white"><strong><i class="fa-solid fa-sliders"></i> Cấu hình chiến dịch</strong></div>
        <div class="card-body">
            @using (Html.BeginForm("SaveSettings", "Marketing", FormMethod.Post, new { area = "Admin" }))
            {
                @Html.AntiForgeryToken()
                if (!ViewData.ModelState.IsValid)
                {
                    @Html.ValidationSummary(false, "Vui lòng kiểm tra các giá trị sau:", new { @class = "alert alert-danger" })
                }
                <div class="alert alert-info border-0 mb-4">
                    <div class="fw-bold"><i class="fa-solid fa-circle-info"></i> Cách hoạt động</div>
                    <div class="small mt-1">Hệ thống chỉ tạo combo khi cặp sản phẩm có đủ số đơn mua chung, tỷ lệ mua kèm và lợi nhuận trung bình theo các ngưỡng bên dưới.</div>
                    <div class="small fw-bold mt-1">Mỗi đơn chỉ nhận một combo tốt nhất; tiền combo được trừ đúng một lần trên tổng đơn, không nhân theo từng sản phẩm hoặc số lượng.</div>
                </div>

                <div class="row g-4">
                    <div class="col-xl-6">
                        <div class="border rounded-3 p-3 h-100 bg-light">
                            <h5 class="text-primary fw-bold mb-1"><i class="fa-solid fa-user-tag"></i> Voucher cá nhân</h5>
                            <p class="text-muted small mb-3">Tạo một ưu đãi cho sản phẩm khách quan tâm nhất.</p>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Tỷ lệ giảm trên sản phẩm</label>
                                    <div class="input-group">@Html.TextBox("PersonalDiscountPct", Model.Settings.PersonalDiscountPct.ToString("0.##", CultureInfo.InvariantCulture), new { @class = "form-control", type = "number", step = "0.01", min = "0.01", max = "100" })<span class="input-group-text">%</span></div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Số tiền giảm tối đa</label>
                                    <div class="input-group">@Html.TextBox("PersonalMaxDiscountAmount", Model.Settings.PersonalMaxDiscountAmount.ToString("0.##", CultureInfo.InvariantCulture), new { @class = "form-control", type = "number", min = "1000", step = "1000" })<span class="input-group-text">₫</span></div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Điểm quan tâm tối thiểu</label>
                                    @Html.TextBox("PersonalMinInterestScore", Model.Settings.PersonalMinInterestScore.ToString("0.##", CultureInfo.InvariantCulture), new { @class = "form-control", type = "number", step = "0.1", min = "0" })
                                    <div class="form-text">Điểm từ xem, click và thêm giỏ. Khuyến nghị: 8.</div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Thời gian sử dụng voucher</label>
                                    <div class="input-group">@Html.TextBox("VoucherValidityHours", Model.Settings.VoucherValidityHours, new { @class = "form-control", type = "number", min = "1" })<span class="input-group-text">giờ</span></div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Chờ trước khi phát lại</label>
                                    <div class="input-group">@Html.TextBox("VoucherCooldownDays", Model.Settings.VoucherCooldownDays, new { @class = "form-control", type = "number", min = "0" })<span class="input-group-text">ngày</span></div>
                                    <div class="form-text">Không phát lại voucher cho cùng sản phẩm trong thời gian này.</div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Chế độ bảo vệ lợi nhuận</label>
                                    @Html.DropDownList("PersonalMinimumMarginPct", new List<SelectListItem>
                                    {
                                        new SelectListItem { Text = "An toàn – giữ tối thiểu 10%", Value = "10", Selected = Model.Settings.PersonalMinimumMarginPct == 10m },
                                        new SelectListItem { Text = "Cân bằng – giữ tối thiểu 5%", Value = "5", Selected = Model.Settings.PersonalMinimumMarginPct != 10m && Model.Settings.PersonalMinimumMarginPct != 2m },
                                        new SelectListItem { Text = "Đẩy bán – giữ tối thiểu 2%", Value = "2", Selected = Model.Settings.PersonalMinimumMarginPct == 2m }
                                    }, new { @class = "form-select" })
                                    <div class="form-text">Hệ thống tự tính chi phí FIFO và tự hạ tiền giảm khi cần.</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-6">
                        <div class="border border-success rounded-3 p-3 h-100">
                            <h5 class="text-success fw-bold mb-1"><i class="fa-solid fa-boxes-stacked"></i> Combo mua chung</h5>
                            <p class="text-muted small mb-3">Chọn cặp từ kết quả Hybrid và giảm một lần trên tổng đơn.</p>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Tỷ lệ giảm trên tổng giá cặp</label>
                                    <div class="input-group">@Html.TextBox("ComboDiscountPct", Model.Settings.ComboDiscountPct.ToString("0.##", CultureInfo.InvariantCulture), new { @class = "form-control", type = "number", step = "0.01", min = "0.01", max = "100" })<span class="input-group-text">%</span></div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Mức giảm tối đa cho cả combo</label>
                                    <div class="input-group">@Html.TextBox("ComboMaxDiscountAmount", Model.Settings.ComboMaxDiscountAmount.ToString("0.##", CultureInfo.InvariantCulture), new { @class = "form-control", type = "number", min = "1000", step = "1000" })<span class="input-group-text">₫ / đơn</span></div>
                                    <div class="form-text">Ví dụ 150.000 ₫ là cả đơn chỉ giảm 150.000 ₫.</div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Số đơn mua chung tối thiểu</label>
                                    @Html.TextBox("ComboMinSupport", Model.Settings.ComboMinSupport, new { @class = "form-control", type = "number", min = "1" })
                                    <div class="form-text">Cặp phải từng xuất hiện cùng nhau trong ít nhất số đơn này.</div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Tỷ lệ khách mua kèm tối thiểu</label>
                                    <div class="input-group">@Html.TextBox("ComboMinConfidencePercent", Model.Settings.ComboMinConfidencePercent.ToString("0.##", CultureInfo.InvariantCulture), new { @class = "form-control", type = "number", step = "0.01", min = "0", max = "100" })<span class="input-group-text">%</span></div>
                                    <div class="form-text">Ví dụ 20%: cứ 100 đơn có A thì ít nhất 20 đơn mua thêm B.</div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Lợi nhuận trung bình của cặp tối thiểu</label>
                                    <div class="input-group">@Html.TextBox("ComboMinUtility", Model.Settings.ComboMinUtility.ToString("0.##", CultureInfo.InvariantCulture), new { @class = "form-control", type = "number", step = "1000", min = "0" })<span class="input-group-text">₫</span></div>
                                    <div class="form-text">Lợi nhuận trung bình trước khi áp dụng giảm combo.</div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Thời gian hoạt động</label>
                                    <div class="input-group">@Html.TextBox("ComboValidityDays", Model.Settings.ComboValidityDays, new { @class = "form-control", type = "number", min = "1" })<span class="input-group-text">ngày</span></div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Số đơn được sử dụng tối đa</label>
                                    <div class="input-group">@Html.TextBox("ComboUsageLimit", Model.Settings.ComboUsageLimit, new { @class = "form-control", type = "number", min = "1" })<span class="input-group-text">đơn</span></div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Chế độ bảo vệ lợi nhuận</label>
                                    @Html.DropDownList("ComboMinimumMarginPct", new List<SelectListItem>
                                    {
                                        new SelectListItem { Text = "An toàn – giữ tối thiểu 10%", Value = "10", Selected = Model.Settings.ComboMinimumMarginPct == 10m },
                                        new SelectListItem { Text = "Cân bằng – giữ tối thiểu 5%", Value = "5", Selected = Model.Settings.ComboMinimumMarginPct != 10m && Model.Settings.ComboMinimumMarginPct != 2m },
                                        new SelectListItem { Text = "Đẩy bán – giữ tối thiểu 2%", Value = "2", Selected = Model.Settings.ComboMinimumMarginPct == 2m }
                                    }, new { @class = "form-select" })
                                    <div class="form-text">Không cần tự tính margin; hệ thống kiểm tra FIFO khi tạo và khi thanh toán.</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="mt-4 d-flex align-items-center gap-3">
                    <button class="btn btn-dark px-4" type="submit"><i class="fa-solid fa-floppy-disk"></i> Lưu cấu hình</button>
                    <span class="text-muted small">Lưu cấu hình trước, sau đó dùng nút tạo voucher hoặc combo bên dưới.</span>
                </div>
            }
        </div>
    </div>

    <div class="d-flex gap-2 mb-4">
        @using (Html.BeginForm("GeneratePersonalVouchers", "Marketing", FormMethod.Post, new { area = "Admin" }))
        {
            @Html.AntiForgeryToken()
            <button class="btn btn-primary" type="submit"><i class="fa-solid fa-user-tag"></i> Tạo voucher cá nhân</button>
        }
        @using (Html.BeginForm("GenerateComboOffers", "Marketing", FormMethod.Post, new { area = "Admin" }))
        {
            @Html.AntiForgeryToken()
            <button class="btn btn-success" type="submit"><i class="fa-solid fa-boxes-stacked"></i> Tạo combo mua chung</button>
        }
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white"><strong>Voucher cá nhân gần đây</strong></div>
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead><tr><th>Mã</th><th>Sản phẩm</th><th>Điểm</th><th>Kích hoạt bởi</th><th>Giảm</th><th>Trạng thái</th><th>Hết hạn</th><th class="text-end">Quản lý</th></tr></thead>
                <tbody>
                @foreach (var item in Model.RecentPersonalVouchers)
                {
                    <tr>
                        <td><code>@item.Code</code></td><td>@item.ProductName</td><td>@item.InterestScore</td>
                        <td>@item.TriggerType</td><td>@item.DiscountAmount.ToString("N0") ₫</td>
                        <td>@item.Status</td><td>@item.ExpiresAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-info" href="@Url.Action("PersonalVoucherDetails", "Marketing", new { area = "Admin", id = item.CustomerCouponID })"><i class="fa-solid fa-eye"></i> Chi tiết</a>
                            @if (item.Status != "USED")
                            {
                                <a class="btn btn-sm btn-outline-primary" href="@Url.Action("EditPersonalVoucher", "Marketing", new { area = "Admin", id = item.CustomerCouponID })"><i class="fa-solid fa-pen"></i> Sửa</a>
                            }
                            <a class="btn btn-sm btn-outline-danger" href="@Url.Action("DeletePersonalVoucher", "Marketing", new { area = "Admin", id = item.CustomerCouponID })"><i class="fa-solid fa-ban"></i> Ngừng</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white"><strong>Combo gần đây</strong> <span class="text-muted small">(bao gồm cả combo đã ngừng)</span></div>
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead><tr><th>Mã</th><th>Sản phẩm A</th><th>Sản phẩm B</th><th>Số đơn mua chung</th><th>Tỷ lệ mua kèm</th><th>LN trung bình</th><th>Giảm/đơn</th><th>Trạng thái</th><th class="text-end">Quản lý</th></tr></thead>
                <tbody>
                @foreach (var item in Model.ManagedCombos)
                {
                    <tr>
                        <td><code>@item.Code</code></td><td>@item.ProductNameA</td><td>@item.ProductNameB</td>
                        <td>@item.Support</td><td>@((item.Confidence * 100).ToString("N0"))%</td>
                        <td>@item.ActualUtility.ToString("N0") ₫</td><td>@item.DiscountAmount.ToString("N0") ₫</td>
                        <td>
                            @if (item.IsActive && item.EndDate > DateTime.Now && item.UsageLimit > 0)
                            { <span class="badge bg-success">Đang hoạt động</span> }
                            else
                            { <span class="badge bg-secondary">Đã ngừng</span> }
                        </td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-info" href="@Url.Action("ComboDetails", "Marketing", new { area = "Admin", id = item.ComboOfferID })"><i class="fa-solid fa-eye"></i> Chi tiết</a>
                            <a class="btn btn-sm btn-outline-primary" href="@Url.Action("EditCombo", "Marketing", new { area = "Admin", id = item.ComboOfferID })"><i class="fa-solid fa-pen"></i> Sửa</a>
                            <a class="btn btn-sm btn-outline-danger" href="@Url.Action("DeleteCombo", "Marketing", new { area = "Admin", id = item.ComboOfferID })"><i class="fa-solid fa-ban"></i> Ngừng</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
