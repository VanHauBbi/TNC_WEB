@model WebBanHang.Models.ViewModel.ComboOfferAdminVM
@{
    ViewBag.Title = "Ngừng combo";
    ViewBag.RemoveSpacing = true;
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}
<link href="~/Content/Admin/marketing_admin.css" rel="stylesheet" />
<div class="mk-page mk-delete-shell">
    <div class="mk-form-card mt-2">
        <div class="mk-delete-warning"><div class="mk-delete-icon"><i class="fa-solid fa-ban"></i></div><h4>Ngừng áp dụng combo này?</h4><p>Combo sẽ không còn hiển thị cho khách. Toàn bộ lịch sử các đơn đã áp dụng vẫn được giữ nguyên.</p></div>
        <div class="mk-delete-facts">
            <div class="mk-info-row"><div class="mk-info-label">Mã combo</div><div class="mk-info-value"><span class="mk-code">@Model.Code</span></div></div>
            <div class="mk-info-row"><div class="mk-info-label">Cặp sản phẩm</div><div class="mk-info-value">@Model.ProductNameA<div class="text-muted my-1">+</div>@Model.ProductNameB</div></div>
            <div class="mk-info-row"><div class="mk-info-label">Giảm một lần/đơn</div><div class="mk-info-value text-danger fw-bold">@Model.DiscountAmount.ToString("N0") ₫</div></div>
        </div>
        @using (Html.BeginForm()) { @Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.ComboOfferID" /><div class="mk-delete-footer"><a class="mk-btn mk-btn-neutral" href="@Url.Action("ComboDetails", new { id = Model.ComboOfferID })">Hủy bỏ</a><button class="mk-btn mk-btn-solid-danger" type="submit"><i class="fa-solid fa-ban"></i> Xác nhận ngừng</button></div> }
    </div>
</div>
