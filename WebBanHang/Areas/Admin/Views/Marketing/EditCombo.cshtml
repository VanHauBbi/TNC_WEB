@model WebBanHang.Models.ViewModel.ComboOfferEditVM
@{
    ViewBag.Title = "Chỉnh sửa combo";
    ViewBag.RemoveSpacing = true;
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}
<link href="~/Content/Admin/marketing_admin.css" rel="stylesheet" />
<div class="mk-page mk-form-shell">
    <div class="mk-page-heading"><div><h3>Chỉnh sửa combo mua chung</h3><p>Giữ nguyên cặp sản phẩm và chỉ cập nhật điều kiện áp dụng.</p></div><a class="mk-btn mk-btn-neutral" href="@Url.Action("ComboDetails", new { id = Model.ComboOfferID })"><i class="fa-solid fa-arrow-left"></i> Quay lại</a></div>
    <div class="mk-form-card">
        <div class="mk-form-header"><div class="mk-form-header-icon"><i class="fa-solid fa-boxes-stacked"></i></div><div><h4>@Model.Code</h4><p>@Model.ProductNameA + @Model.ProductNameB</p></div></div>
        <div class="mk-form-body">
            <div class="mk-safety-note"><i class="fa-solid fa-shield-halved me-2"></i><strong>Bảo vệ tự động:</strong> tiền giảm áp dụng một lần/đơn và tự hạ nếu vượt ngân sách FIFO.</div>
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.ComboOfferID) @Html.HiddenFor(m => m.Code) @Html.HiddenFor(m => m.ProductNameA) @Html.HiddenFor(m => m.ProductNameB)
                @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })
                <div class="row g-3">
                    <div class="col-md-4"><label class="form-label">Mã combo</label><input class="form-control mk-readonly" value="@Model.Code" readonly /></div>
                    <div class="col-md-4"><label class="form-label">Sản phẩm A</label><input class="form-control mk-readonly" value="@Model.ProductNameA" readonly /></div>
                    <div class="col-md-4"><label class="form-label">Sản phẩm B</label><input class="form-control mk-readonly" value="@Model.ProductNameB" readonly /></div>
                    <div class="col-md-6"><label class="form-label">Tiền giảm cho cả combo</label><div class="input-group">@Html.TextBoxFor(m => m.DiscountAmount, new { @class = "form-control", type = "number", min = "1000", step = "1000", Value = Model.DiscountAmount.ToString("0", System.Globalization.CultureInfo.InvariantCulture) })<span class="input-group-text">₫ / đơn</span></div>@Html.ValidationMessageFor(m => m.DiscountAmount, "", new { @class = "text-danger small" })</div>
                    <div class="col-md-6"><label class="form-label">Lượt sử dụng còn lại</label>@Html.TextBoxFor(m => m.UsageLimit, new { @class = "form-control", type = "number", min = "0" })@Html.ValidationMessageFor(m => m.UsageLimit, "", new { @class = "text-danger small" })</div>
                    <div class="col-md-6"><label class="form-label">Ngày bắt đầu</label>@Html.TextBoxFor(m => m.StartDate, "{0:yyyy-MM-ddTHH:mm}", new { @class = "form-control", type = "datetime-local" })@Html.ValidationMessageFor(m => m.StartDate, "", new { @class = "text-danger small" })</div>
                    <div class="col-md-6"><label class="form-label">Ngày kết thúc</label>@Html.TextBoxFor(m => m.EndDate, "{0:yyyy-MM-ddTHH:mm}", new { @class = "form-control", type = "datetime-local" })@Html.ValidationMessageFor(m => m.EndDate, "", new { @class = "text-danger small" })</div>
                    <div class="col-12"><div class="form-check form-switch mt-2">@Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input" })<label class="form-check-label fw-semibold" for="IsActive">Cho phép combo tiếp tục hoạt động</label></div></div>
                </div>
                <div class="mk-form-footer"><a class="mk-btn mk-btn-neutral" href="@Url.Action("ComboDetails", new { id = Model.ComboOfferID })">Hủy</a><button class="mk-btn mk-btn-solid" type="submit"><i class="fa-solid fa-floppy-disk"></i> Lưu thay đổi</button></div>
            }
        </div>
    </div>
</div>
