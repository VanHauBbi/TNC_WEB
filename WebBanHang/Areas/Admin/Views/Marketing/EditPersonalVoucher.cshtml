@model WebBanHang.Models.ViewModel.PersonalVoucherEditVM
@{
    ViewBag.Title = "Chỉnh sửa voucher cá nhân";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-3">
    <div class="card shadow-sm border-0 mx-auto" style="max-width:850px">
        <div class="card-header bg-white"><h4 class="mb-0"><i class="fa-solid fa-pen text-primary"></i> Chỉnh sửa voucher cá nhân</h4></div>
        <div class="card-body p-4">
            <div class="alert alert-info"><strong>Bảo vệ tự động:</strong> nếu số tiền nhập làm lợi nhuận FIFO thấp hơn chế độ đã chọn, hệ thống sẽ tự hạ tiền giảm khi lưu.</div>
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.CustomerCouponID)
                @Html.HiddenFor(m => m.Code)
                @Html.HiddenFor(m => m.CustomerName)
                @Html.HiddenFor(m => m.ProductName)
                @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })
                <div class="row g-3">
                    <div class="col-md-6"><label class="form-label fw-bold">Mã voucher</label><input class="form-control" value="@Model.Code" readonly /></div>
                    <div class="col-md-6"><label class="form-label fw-bold">Khách hàng</label><input class="form-control" value="@Model.CustomerName" readonly /></div>
                    <div class="col-12"><label class="form-label fw-bold">Sản phẩm áp dụng</label><input class="form-control" value="@Model.ProductName" readonly /></div>
                    <div class="col-md-6"><label class="form-label fw-bold">Số tiền giảm</label><div class="input-group">@Html.TextBoxFor(m => m.DiscountAmount, new { @class = "form-control", type = "number", min = "1000", step = "1000", Value = Model.DiscountAmount.ToString("0", System.Globalization.CultureInfo.InvariantCulture) })<span class="input-group-text">₫</span></div>@Html.ValidationMessageFor(m => m.DiscountAmount, "", new { @class = "text-danger" })</div>
                    <div class="col-md-6"><label class="form-label fw-bold">Hạn sử dụng</label>@Html.TextBoxFor(m => m.ExpiresAt, "{0:yyyy-MM-ddTHH:mm}", new { @class = "form-control", type = "datetime-local" })@Html.ValidationMessageFor(m => m.ExpiresAt, "", new { @class = "text-danger" })</div>
                    <div class="col-12"><div class="form-check form-switch">@Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input" })<label class="form-check-label fw-bold" for="IsActive">Cho phép voucher tiếp tục hoạt động</label></div></div>
                </div>
                <div class="mt-4 d-flex gap-2"><button class="btn btn-primary" type="submit"><i class="fa-solid fa-floppy-disk"></i> Lưu thay đổi</button><a class="btn btn-secondary" href="@Url.Action("PersonalVoucherDetails", new { id = Model.CustomerCouponID })">Hủy</a></div>
            }
        </div>
    </div>
</div>
